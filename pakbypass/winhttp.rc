#include <windows.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
            VALUE "CompanyName", "WuwaID"
            VALUE "FileDescription", "Windows HTTP Services Proxy"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "winhttp"
            VALUE "LegalCopyright", "Copyright (C) 2024-2026 WuwaID"
            VALUE "OriginalFilename", "winhttp.dll"
            VALUE "ProductName", "WuWa Indonesian Localization"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
