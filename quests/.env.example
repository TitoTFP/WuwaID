# wuwaid-quests production environment (copy to .env)
# CORS origins for the web UI, comma-separated. Production example:
#   WUWAID_ORIGINS=https://wuwaid.titotfp.my.id
# Leave empty to default to local dev origins (localhost:5173).
WUWAID_ORIGINS=

# Admin log dashboard: URL of the log-server and its admin token.
# The quests backend proxies /api/admin/logs/* to this URL with the token
# injected server-side; the browser never receives the token.
WUWAID_LOG_SERVER_URL=
WUWAID_ADMIN_TOKEN=

# Separate admin password for the /admin/login page. If unset, admin login
# returns 503 (fail closed) — matching the test-first contract.
ADMIN_PASSWORD=
