# systemd user unit for wuwaid-quests (FastAPI serving web/dist + /api)
# Install: cp wuwaid-quests.service ~/.config/systemd/user/ && systemctl --user daemon-reload
# Enable: systemctl --user enable --now wuwaid-quests
#
# Requires data/ (run `uv run python scripts/build_index.py` first) and a
# production build (bun run build -> web/dist). Env comes from .env.
[Unit]
Description=WuwaID Quests WebUI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/nozomi/wuwaid-quests
EnvironmentFile=/home/nozomi/wuwaid-quests/.env
ExecStart=/home/nozomi/.local/bin/uv run uvicorn app.main:app --host 127.0.0.1 --port 8000 --app-dir .
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
