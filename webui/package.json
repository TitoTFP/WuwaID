{
  "name": "wuwaid-webui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,server -c cyan,yellow \"vite\" \"tsx watch server/dev.ts\"",
    "dev:web": "vite",
    "dev:server": "tsx watch server/dev.ts",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "build:web": "tsc --noEmit && vite build",
    "start": "node dist/server/start.js",
    "check": "tsc --noEmit",
    "qa": "tsx server/translationQaCli.ts",
    "test:qa": "tsx --test server/translationQa.test.ts server/translationQa.integration.test.ts",
    "test:integration": "tsx --test --test-concurrency=1 server/translationQa.integration.test.ts server/ops.integration.test.ts server/reader.integration.test.ts",
    "benchmark:reader": "node scripts/benchmark-reader.mjs",
    "build:reader-index": "tsx scripts/build-reader-index.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.0",
    "cmdk": "^1.0.0",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "framer-motion": "^11.11.11",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.8.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
